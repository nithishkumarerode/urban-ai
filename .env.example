# ==============================================================================
# UrbanCadastral AI - Environment Configuration
# Real-Time AI-Assisted Urban Cadastral Mapping & GIS Platform
# ==============================================================================

# Application Environment
ENVIRONMENT=development
APP_DEBUG=True
APP_NAME=UrbanCadastral AI
API_V1_STR=/api

# Backend Server
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:5173

# PostgreSQL + PostGIS Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_cadastral_secure_pass
POSTGRES_DB=urbancadastral_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://postgres:postgres_cadastral_secure_pass@localhost:5432/urbancadastral_db

# Security & JWT Authentication
# Generate a strong 64-character secret for production: openssl rand -hex 32
JWT_SECRET_KEY=9f8c6b5e2a3d7f1c4e8b0a9d2f5e7a1c4b8d0e2f5a7c9e1b3d5f7a9c1e3b5d7f
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Initial Seed Test Account (Used for development authentication)
TEST_USER_EMAIL=test@example.com
TEST_USER_PASSWORD=AdminCadastral2026!
TEST_USER_NAME=Senior Cadastral Surveyor

# AI Model Configuration (Weights MUST be placed in backend/models/weights/)
AI_MODEL_PATH=backend/models/weights/cadastral_segmentation.onnx
AI_DEVICE=cpu
AI_CONFIDENCE_THRESHOLD=0.65

# Data Storage Directories
UPLOAD_DIR=data/uploads
PROCESSED_DIR=data/processed
EXPORT_DIR=data/exports

# GIS Projection Settings
DEFAULT_PROJECTED_CRS=EPSG:3857
METRIC_PROJECTION_FALLBACK=EPSG:32633
